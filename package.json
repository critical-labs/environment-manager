{
  "name": "@critical-labs/environment-manager",
  "version": "0.3.0",
  "description": "Declarative environment variable sync, secret rotation, fingerprint verification, and .env rendering, driven by a .environment-manager/ config directory.",
  "keywords": [
    "environment-variables",
    "secrets",
    "rotation",
    "1password",
    "github-actions-secrets",
    "neon",
    "dotenv"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Critical Labs",
  "homepage": "https://github.com/critical-labs/environment-manager#readme",
  "bugs": {
    "url": "https://github.com/critical-labs/environment-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/critical-labs/environment-manager.git"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "environment-manager": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepare": "husky && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "libsodium-wrappers": "^0.7.15",
    "pg": "^8.20.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "typescript": "5.6.3",
    "vitest": "^3.2.4"
  }
}
